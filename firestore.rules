rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId;
      match /private/{docId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.from == uid();
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() in request.resource.data.users;
      allow update: if signedIn() && uid() in resource.data.users;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        allow create: if signedIn()
          && request.resource.data.from == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /gigs/{gigId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow update, delete: if signedIn() && resource.data.ownerUid == uid();
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == uid();
      allow update: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid());
      allow delete: if false;
    }
  }
}
